# LOCAL DEVELOPMENT ONLY. Never commit this file.
# Create a NEW key in Google AI Studio. Do not reuse the key from the uploaded HTML.
GEMINI_API_KEY=PASTE_YOUR_NEW_GEMINI_API_KEY_HERE

# Current model IDs; adjust only if your Google AI Studio project does not have access.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Generate a random secret of at least 32 characters for signed admin sessions.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_PASSCODE=REPLACE_WITH_A_STRONG_ADMIN_PASSCODE

PORT=3000
NODE_ENV=development
